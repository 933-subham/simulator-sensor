# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000

# ─── Security ────────────────────────────────────────────────────────────────
# Global API key required on all endpoints except GET /api/health.
# Leave empty to disable API-key enforcement (useful in local dev).
API_KEY=

# ─── Simulation ──────────────────────────────────────────────────────────────
# How often the simulator generates a new reading (milliseconds).
TICK_INTERVAL_MS=2000

# Whether the simulator may generate random faults on its own.
# Set to false (default) so faults only happen when YOU inject them.
RANDOM_FAULTS=false

# Optional seed for the PRNG — makes noise 100% repeatable across restarts.
# Any string or number works, e.g. RANDOM_SEED=campus42
RANDOM_SEED=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all.
# Example: https://my-dashboard.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# ─── Outbound Push Mode ───────────────────────────────────────────────────────
# When true, the simulator POSTs every device reading to PUSH_TARGET_URL on
# each tick, signed with the device's HMAC secret.  Pull endpoints + SSE still
# work regardless of this setting.
PUSH_ENABLED=false
PUSH_TARGET_URL=

# ─── Fault Webhook ────────────────────────────────────────────────────────────
# If set, a POST is sent here whenever a fault starts or clears.
FAULT_WEBHOOK_URL=
# Sent as the x-webhook-secret header so your server can verify the call.
WEBHOOK_SECRET=

# ─── Cloudinary Storage ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=
CLOUDINARY_SECURE=true
CLOUDINARY_DEFAULT_FOLDER=sensor-sim

